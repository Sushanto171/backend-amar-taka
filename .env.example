PORT=5000
NODE_ENV=development

DB_URL=mongodb://localhost:27017/amar-taka


# BCRYPT
BCRYPT_SALT_ROUND=10

# JWT
JWT_ACCESS_SECRET=JWT_ACCESS_SCERET
JWT_ACCESS_EXPIRATION=15m

JWT_REFRESH_SECRET=JWT_REFESH_SECRET
JWT_REFRESH_EXPIRATION=15d

#ADMIN_CONFIGURATION
ADMIN_PHONE=01234567891
ADMIN_PASSWORD=123456
ADMIN_NAME=System
ADMIN_INITIAL_SYSTEM_FUND=1000000000 # 10,000,000 TK
ADMIN_EMAIL=support@amartaka.com
LOCK_LOGIN_UNTIL=900000 #15min

#DEPOSIT
MINIMUM_DEPOSIT_AMOUNT=5000 #50 TK
DEPOSIT_PERCENT_FEE=2
SYSTEM_DEPOSIT_REVENUE_PERCENT=25
AGENT_DEPOSIT_REVENUE_PERCENT=75

#WTIHDRAW
MINIMUM_WITHDRAW_AMOUNT=0
WITHDRAW_PERCENT_FEE=2
SYSTEM_WITHDRAW_REVENUE_PERCENT=50
AGENT_WITHDRAW_REVENUE_PERCENT=50

#P2P (SendMoney User - User)
P2P_PER_THOUSAND_CHARGE=500 # 5TK


# USER_CONFIGURATION>>
USER_WELCOME_BONUS=5000 # 50 TK
USER_DAILY_CASHOUT_LIMIT=2500000 # 25,000 TK
USER_MONTHLY_CASHOUT_LIMIT=5000000 #50,000 TK

#AGENT_CONFIGURATION >>paisa
AGENT_INITIAL_BALANCE=100000 
AGENT_DAILY_CASHOUT_LIMIT=5000000
AGENT_MONTHLY_CASHOUT_LIMIT=20000000
